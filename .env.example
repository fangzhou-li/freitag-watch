# Bark：只放入 GitHub Actions Secrets，不要提交真实值
BARK_KEY=
BARK_SERVER=https://api.day.app

# GitHub Pages 地址；部署时工作流会自动推导，可选覆盖
WEBSITE_URL=

# 邮件默认关闭。得到明确授权后才在 GitHub Secrets 中设置。
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# 采集设置
FREITAG_LOCALE=en_US
REQUEST_DELAY_SECONDS=1.5
REQUEST_TIMEOUT_SECONDS=30

